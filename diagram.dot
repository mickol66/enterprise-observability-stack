digraph "Diagram" {
  splines = "ortho";
  pad = 1;
  nodesep = 0.6;
  ranksep = 0.75;
  fontname = "Sans-Serif";
  fontsize = 15;
  dpi = 200;
  rankdir = "BT";
  compound = true;
  fontcolor = "#222222";
  edge [
    color = "#D5871488";
    penwidth = 2;
    arrowhead = "dot";
    arrowtail = "dot";
  ];
  node [
    shape = "box";
    style = "rounded";
    fixedsize = true;
    width = 1.7;
    height = 1.7;
    labelloc = "c";
    imagescale = true;
    fontname = "Sans-Serif";
    fontsize = 8;
    margin = 8;
  ];
  subgraph "EnterpriseObservabilityStack" {
    subgraph "cluster-SubGraph.EnterpriseObservabilityStack" {
      graph [
        label = "EnterpriseObservabilityStack";
        labelloc = "b";
        labeljust = "l";
        margin = 10;
        fontsize = 16;
        penwidth = 2;
        pencolor = "#888888";
        style = "filled,rounded";
        fillcolor = "#e4e4e4";
      ];
      "EnterpriseObservabilityStack/SystemAlertTopic" [
        label = " SystemAlertTopic";
        fontsize = 12;
        image = "C:\Users\mikae\AppData\Roaming\npm\node_modules\cdk-dia\icons\aws\Service\Arch_App-Integration\Arch_64\Arch_AWS-Simple-Notification-Service_64@5x.png";
        imagescale = "true";
        imagepos = "tc";
        penwidth = 0;
        shape = "node";
        fixedsize = "true";
        labelloc = "b";
        width = 2;
        height = 2.266;
      ];
      "EnterpriseObservabilityStack/KinesisS3FailureAlarm" [
        label = "\nKinesisS3FailureAlarm";
        fontsize = 12;
        image = "C:\Users\mikae\AppData\Roaming\npm\node_modules\cdk-dia\icons\aws\Service\Arch_Management-Governance\64\Arch_Amazon-CloudWatch_64@5x.png";
        imagescale = "true";
        imagepos = "tc";
        penwidth = 0;
        shape = "node";
        fixedsize = "true";
        labelloc = "b";
        width = 1.2;
        height = 1.682;
      ];
      "EnterpriseObservabilityStack/EcsCpuAnomalyAlarm" [
        label = " EcsCpuAnomalyAlarm";
        fontsize = 12;
        image = "C:\Users\mikae\AppData\Roaming\npm\node_modules\cdk-dia\icons\aws\Service\Arch_Management-Governance\64\Arch_Amazon-CloudWatch_64@5x.png";
        imagescale = "true";
        imagepos = "tc";
        penwidth = 0;
        shape = "node";
        fixedsize = "true";
        labelloc = "b";
        width = 1.2;
        height = 1.466;
      ];
      "EnterpriseObservabilityStack/EnterpriseOperationsDashboard" [
        label = "\nEnterpriseOperationsD";
        fontsize = 12;
        image = "C:\Users\mikae\AppData\Roaming\npm\node_modules\cdk-dia\icons\aws\Service\Arch_Management-Governance\64\Arch_Amazon-CloudWatch_64@5x.png";
        imagescale = "true";
        imagepos = "tc";
        penwidth = 0;
        shape = "node";
        fixedsize = "true";
        labelloc = "b";
        width = 1.2;
        height = 1.682;
      ];
    }
  }
  "EnterpriseObservabilityStack/KinesisS3FailureAlarm" -> "EnterpriseObservabilityStack/SystemAlertTopic" [
    dir = "both";
  ];
  "EnterpriseObservabilityStack/EcsCpuAnomalyAlarm" -> "EnterpriseObservabilityStack/SystemAlertTopic" [
    dir = "both";
  ];
}